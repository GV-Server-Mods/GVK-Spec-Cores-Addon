<?xml version="1.0" encoding="utf-16"?>
<ModSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <TLBlocks>
    <BlockConfig>
      <Matcher>Refinery/*</Matcher>
      <PointType>0</PointType><!-- Id of point -->
      <MinimalSecondsForActivation>1</MinimalSecondsForActivation><!-- How much points it drains when activated -->
      <DrainAmount>1</DrainAmount><!-- How much it drains points per second -->
      <CanBeBoosted>true</CanBeBoosted><!-- Can be boosted or not -->
      <MinBoost>1</MinBoost><!-- Minimal boost-->
      <MaxBoost>12</MaxBoost><!-- How much times it can work faster-->
    </BlockConfig>
