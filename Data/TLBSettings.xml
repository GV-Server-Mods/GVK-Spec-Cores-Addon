  </TLBlocks>
  <PointInfos>
    <PointInfo Id="0" Name="Refinery" MaxValue="172800" DefaultValue="172800" AddPerSecondWhenOnline="1" AddPerSecondWhenOffline="1" />
	<!-- 
		Name of Point: points wont be added above this value
		MaxValue: points wont be added above this value
		DefaultValue: points for players that has just started play
		AddPerSecondWhenOnline: points that would be added per second when player is Online
		AddPerSecondWhenOffline: points that would be added per second when player is Offline
	-->
    <PointInfo Id="1" Name="Assembler" MaxValue="172800" DefaultValue="172800" AddPerSecondWhenOnline="1" AddPerSecondWhenOffline="1" />
    <PointInfo Id="2" Name="H2/O2" MaxValue="172800" DefaultValue="172800" AddPerSecondWhenOnline="1" AddPerSecondWhenOffline="1" />
  </PointInfos>
  <GivePointsCommand>!GivePoints</GivePointsCommand>
  <AdminAddPointsCommand>!GivePointsAdmin</AdminAddPointsCommand>
  <UsableItems>
	<!-- 
		Per each 1 Ore/Uranium gives 1 point to Refinery
	-->
	<UsableItem Item="Ore/Uranium" GiveSeconds="1" PointType="0" />
  </UsableItems>
