	<Transformation MaterialSubtype="SmallMoonRocks" ExcavatableName="StoneEx"/>
	<Transformation MaterialSubtype="DebugMaterial" ExcavatableName="StoneEx"/>
	<Transformation MaterialSubtype="Sand_02" ExcavatableName="StoneEx"/>
	<Transformation MaterialSubtype="DesertRocks" ExcavatableName="StoneEx"/>
