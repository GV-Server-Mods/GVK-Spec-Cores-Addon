<ModSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" SpotSizeInMeters="200" SyncDistance="5000" SyncInterval="100">
  <!-- Hud settings -->
  <Hud>
	<PlateIcon>OrePlate</PlateIcon> <!-- Name of transparent material -->
    <PlateOffsetX>0.64</PlateOffsetX>
    <PlateOffsetY>-0.82</PlateOffsetY>
    <OreOffsetX>0.615</OreOffsetX>
    <OreOffsetY>-0.84</OreOffsetY>
    <OreLeftText>Ore left ({0}/{1})</OreLeftText>
    <PlateColor>
      <X>0.14509804546833038</X>
      <Y>0.18431372940540314</Y>
      <Z>0.21960784494876862</Z>
      <W>0.46666666865348816</W>
    </PlateColor>
    <IconColor>
      <X>1</X>
      <Y>1</Y>
      <Z>1</Z>
      <W>1</W>
    </IconColor>
    <UpdateIntervalInFrames>240</UpdateIntervalInFrames><!-- How often swtich between voxels -->
  </Hud>
  
  <!-- 
	Transformation
		How voxel materials are binded to `Excavatable`.
		Use ExcavatableName="<None>" to make it not limited (Where <None> - any not existing ExcavatableName)
		If you have custom VoxelMaterials(Custom ores), and you want them to be limited, you would need add their VoxelMaterial:`SubtypeName` into this list
		
	Excavatables:
		How voxel materials are limited. For example you have Iron_01 & Iron_02, if you want them be limited differently, create 2 different Excavatables
		If you want them be limited by 1 limit, use same ExcavatableName.
			Name - GroupId
			Icon - Icon would be displayed in Hud. (TransparentMaterials SubtypeName) NOTE: You would need add TransparentMaterial and Icon, per each custom ore. It should be .DDS
			ExcavatableLocalization - Name that would be printed in hud
			
			
	
	Asteroids, DefaultPlanets, Planet:
		ResetTimer - how much time in seconds it needs to make voxels minable again 
		SpotSize - Diametor of spot in meters
		MaxAmounts:
			List of all `Excavatable` that should be limited
		OreInfo:
			ExcavatableName - name of excavatable
			Amount - amount of resources that are limited.
		Transformations 
			Custom bindings per each Area: DefaultPlanets, Planet, or Asteroids
	  
  -->
  
  <Asteroids ResetTimer="86400" SpotSize="200">
    <MaxAmounts>
      <OreInfo ExcavatableName="StoneEx" Amount="99999" />
    </MaxAmounts>
    <Transformations>
      <Transformation MaterialSubtype="Stone_01" ExcavatableName="Stone" />
    </Transformations>
  </Asteroids>
  <DefaultPlanets ResetTimer="86400" SpotSize="200">
    <MaxAmounts>
      <OreInfo ExcavatableName="StoneEx" Amount="99999" />
    </MaxAmounts>
  </DefaultPlanets>
  <PlanetSettings>
    <Planet PlanetName="EarthLike" PlanetEntityId="0" ResetTimer="86400" SpotSize="200">
      <MaxAmounts>
        <OreInfo ExcavatableName="StoneEx" Amount="99999" />
      </MaxAmounts>
    </Planet>
  </PlanetSettings>
  <Excavatables>
    <Excavatable Name="StoneEx" Icon="Stone" ExcavatableLocalization="Stone"/>
  </Excavatables>
  <DefaultTransformations>
    <Transformation MaterialSubtype="Stone_01" ExcavatableName="StoneEx"/>
	<Transformation MaterialSubtype="Stone_02" ExcavatableName="StoneEx"/>
	<Transformation MaterialSubtype="Stone_03" ExcavatableName="StoneEx"/>
	<Transformation MaterialSubtype="Stone_04" ExcavatableName="StoneEx"/>
